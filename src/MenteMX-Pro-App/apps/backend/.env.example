# MenteMX Pro - Backend Environment Variables
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
# Para protótipo/Vercel: use Neon.tech (PostgreSQL grátis na nuvem)
# Crie em: https://neon.tech → copie a connection string
DATABASE_URL=postgresql://user:password@localhost:5432/mentemx_pro

# JWT
JWT_SECRET=mentemx-pro-secret-change-in-production
JWT_EXPIRES_IN=7d

# Vercel (não alterar)
VERCEL=0
